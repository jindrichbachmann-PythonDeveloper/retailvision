# =========================
# RetailVision env example
# Copy this file to .env and fill real values.
# Never commit real .env to GitHub.
# =========================

APP_NAME=RetailVision
ENV=dev
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Web / domains
PUBLIC_BASE_URL=http://127.0.0.1:8000
DEFAULT_DOMAIN=retailvisionuzivatel.cz
DOMAIN_USER=retailvisionuzivatel.cz
DOMAIN_CUSTOMER=retailvisionzakaznik.cz
ALLOWED_HOSTS=localhost,127.0.0.1,retailvisionuzivatel.cz,retailvisionzakaznik.cz
GUARD_ENABLED=1

# PostgreSQL
POSTGRES_DSN=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/retailvision

# MongoDB / GridFS
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=hodinkovy_obchod
DB_NAME=hodinkovy_obchod
MONGO_GRIDFS_BUCKET=fs

# OpenAI
OPENAI_API_KEY=CHANGE_ME
MODEL_NAME=gpt-4o-mini
MODEL_RECOG=gpt-4o
IMAGE_MODEL=gpt-image-1.5

# YOLO
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONF_TH=0.25

# JWT
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ALG=HS256
JWT_EXPIRE_MIN=120

# Stripe
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME

# SMTP / email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ACCOUNTANT_EMAIL=
INVOICE_DEV_EMAIL=

# Invoices
INVOICE_BASE_DIR=invoices
INVOICE_DIR=invoices
VAT_RATE=0.21
COMPANY_NAME=RetailVision
COMPANY_ICO=
COMPANY_DIC=
BANK_ACCOUNT=

# Debug folders
AI_DEBUG_DIR=debug_ai
